{
  "lock": false,
  "nodeModulesDir": "manual",
  "compilerOptions": {
    "strict": true,
    "checkJs": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true
  },
  "lint": {
    "rules": {
      "tags": [],
      "include": [
        "no-explicit-any",
        "ban-ts-comment"
      ]
    }
  }
}
