{
  "lock": false,
  "nodeModulesDir": "none",
  "compilerOptions": {
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "lib": [
      "deno.window",
      "esnext"
    ],
    "types": [
      "npm:@types/node@26.6.6"
    ]
  },
  "lint": {
    "rules": {
      "tags": [],
      "include": [
        "no-explicit-any",
        "ban-ts-comment"
      ]
    }
  }
}
